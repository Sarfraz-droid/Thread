  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "html": "<button class=\"ds-primary\">New opportunity</button>",
      "css": ".ds-primary{font-family:var(--font-sans);font-size:14px;background:var(--primary);color:var(--primary-foreground);border:1px solid transparent;border-radius:8px;height:36px;padding:0 12px;font-weight:500;transition:background-color 150ms}.ds-primary:hover{opacity:.9}.ds-primary:focus-visible{outline:2px solid var(--ring);outline-offset:3px}.ds-primary:active{transform:translateY(1px)}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "html": "<button class=\"ds-outline\">Close</button>",
      "css": ".ds-outline{font-family:var(--font-sans);font-size:14px;background:var(--background);color:var(--foreground);border:1px solid var(--border);border-radius:8px;height:36px;padding:0 12px}.ds-outline:hover{background:var(--muted)}.ds-outline:focus-visible{outline:2px solid var(--ring);outline-offset:3px}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "html": "<label class=\"ds-field\">Referral context<input placeholder=\"Paste a referral or job link\"></label>",
      "css": ".ds-field{font-family:var(--font-sans);font-size:14px;display:grid;gap:8px;color:var(--foreground)}.ds-field input{font:inherit;background:var(--background);color:var(--foreground);border:1px solid var(--input);border-radius:8px;padding:10px 12px}.ds-field input:hover{border-color:var(--border)}.ds-field input:focus-visible{outline:2px solid var(--ring);outline-offset:3px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Dashboard</a><a href=\"#\">Opportunities</a></nav>",
      "css": ".ds-nav{font-family:var(--font-sans);font-size:14px;display:grid;gap:4px}.ds-nav a{padding:10px 12px;color:var(--foreground);text-decoration:none;border-radius:8px}.ds-nav a[aria-current],.ds-nav a:hover{background:var(--accent)}.ds-nav a:focus-visible{outline:2px solid var(--ring);outline-offset:3px}"
    },
    {
      "name": "Status badge",
      "kind": "chip",
      "html": "<span class=\"ds-badge\">Drafted</span>",
      "css": ".ds-badge{font-family:var(--font-sans);font-size:14px;font-size:12px;background:var(--secondary);color:var(--secondary-foreground);border-radius:6px;padding:2px 8px}"
    },
    {
      "name": "Intake surface",
      "kind": "card",
      "html": "<section class=\"ds-intake\"><h2>New opportunity</h2><p>Bring in the context.</p></section>",
      "css": ".ds-intake{font-family:var(--font-sans);font-size:14px;background:var(--card);color:var(--foreground);border:1px solid var(--border);border-radius:14px;padding:28px}.ds-intake h2{font-size:23px;font-weight:500;margin:0}.ds-intake p{color:var(--muted-foreground);margin:6px 0 0}"
    }
  ],
  "narrative": {
    "overview": "Thread uses the user-supplied TweakCN theme (`https://tweakcn.com/r/themes/cmowxedip000004kzeb7y6a9k`) in its light presentation: warm ivory, restrained blue, generous space, and readable operational controls. This supersedes the earlier sage correspondence mockups, which remain historical references. Light is the default; a persistent sun/moon switch on the landing page, login page, and workspace selects light or dark and updates toast styling.\n\nSerif branding and selected display headings add the character of personal correspondence. Outfit keeps navigation, forms, and workspace titles clear. Public introduction and authenticated operation share the same visual vocabulary with different density and hierarchy.",
    "keyCharacteristics": [
      "Warm, quiet surfaces with a restrained blue action accent.",
      "Serif display moments paired with practical sans-serif controls.",
      "Clear next actions and explicit workflow states."
    ],
    "rules": [],
    "dos": [
      "use semantic theme tokens and the light default presentation.",
      "distinguish loading, disabled, empty, and error states.",
      "use real account data for workspace metrics and activity.",
      "label public illustrative content explicitly and keep preview content free of account data.",
      "keep credentials server-side and email sending under owner review."
    ],
    "donts": [
      "replace the incumbent palette with the historical sage palette.",
      "make promotional page compositions mandatory across operational screens.",
      "display invented account activity or metrics."
    ]
  }
}
