APP_URL=http://localhost:3000
OWNER_EMAIL=you@example.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 64 hexadecimal characters (32 random bytes)
ENCRYPTION_KEY=
AKASH_API_KEY=
AKASH_MODEL=zai-org/GLM-5.3
TAVILY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set AI_PROVIDER=akash to use Vercel AI Gateway; akash retains AkashML.
AI_PROVIDER=akash
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=zai/glm-5.3

# Together AI (select together in Settings or set AI_PROVIDER=together)
TOGETHER_API_KEY=
TOGETHER_MODEL=MiniMaxAI/MiniMax-M3

# Groq (select groq in Settings or set AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (select openrouter in Settings or set AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto-beta

# Memory layer (Mem0 on Supabase pgvector). Leave unset to use the built-in memory table.
# Direct Postgres connection string (Supabase: Project Settings > Database > Connection pooling).
MEM0_DATABASE_URL=
# Embeddings via OpenRouter (any OpenAI-compatible endpoint works). The dimension must match the migration (768).
MEM0_EMBEDDING_API_KEY=
MEM0_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
MEM0_EMBEDDING_MODEL=baai/bge-base-en-v1.5
MEM0_EMBEDDING_DIMS=768
